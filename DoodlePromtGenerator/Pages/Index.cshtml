@page
@model DoodlePromptGenerator.Pages.IndexModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Art Idea Generator</title>
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="icon" type="image/png" href="~/images/logo3.png" />
</head>
<body>
    <div class="app-shell">
        @if (string.IsNullOrWhiteSpace(Model.Output))
        {
            <div class="intro-block">
                <img src="~/images/logo.png" alt="Art Prompt Generator Logo" class="logo-image" />
                <p class="intro-text">
                    No art ideas? No problem.<br />
                    Just generate and draw.
                </p>
            </div>
        }
        else
        {
            <div class="prompt-stage" id="promptStage">
                <div class="prompt-scale-box" id="promptScaleBox">
                    <pre id="promptSource" class="prompt-source">@Model.Output</pre>
                    <div id="promptOutput" class="prompt-output"></div>
                </div>
            </div>
        }

        <form method="post" id="generateForm">
            <input type="hidden" id="PromptCount" name="PromptCount" value="@Model.PromptCount" />
            <button type="submit" asp-page-handler="Generate" class="generate-button" id="generateButton">
                @Model.GetButtonText()
            </button>
        </form>
    </div>

    <script>
            document.addEventListener("DOMContentLoaded", () => {
                const form = document.getElementById("generateForm");
                const button = document.getElementById("generateButton");
                const promptSource = document.getElementById("promptSource");
                const promptOutput = document.getElementById("promptOutput");

                let isSubmitting = false;

                if (form && button) {
                    form.addEventListener("submit", function () {
                        if (isSubmitting) return;

                        isSubmitting = true;
                        button.textContent = "One second...";
                        button.disabled = true;
                    });
                }

                document.addEventListener("keydown", function (event) {
                    if (event.key === "Enter") {
                        event.preventDefault();

                        if (form && button && !button.disabled && !isSubmitting) {
                            isSubmitting = true;
                            button.textContent = "Generating...";
                            button.disabled = true;
                            form.requestSubmit(button);
                        }
                    }
                });

                if (promptSource && promptOutput) {
                    const finalText = promptSource.textContent || "";
                    animateLines(finalText, promptOutput, () => {
                        fitPromptToViewport();
                    });
                }

                window.addEventListener("resize", fitPromptToViewport);
                window.addEventListener("orientationchange", fitPromptToViewport);

                setTimeout(fitPromptToViewport, 50);
                setTimeout(fitPromptToViewport, 150);
            });

            function animateLines(text, container, onComplete) {
                const chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789!@@#$%^&*()_+-=[]{};:<>?/\\\\|√∆∑πµΩ€£¥¢₹₿₩₪₫АБВГДЕЖЗИЙКЛМНОПРСТУФХЦЧШЩЫЭЮЯΔλΩΨΦΘΣ";
                const lines = text.split(/\r?\n/);

                container.innerHTML = "";
                container.classList.remove("finished");

                const lineStates = lines.map(line => {
                    const div = document.createElement("div");
                    div.className = "prompt-line";
                    div.textContent = "";
                    container.appendChild(div);

                    return {
                        finalText: line,
                        element: div,
                        progress: 0,
                        done: false
                    };
                });

                let lastTime = 0;
                const frameDelay = 45;
                const scrambleWindow = 8;

                function frame(timestamp) {
                    if (timestamp - lastTime < frameDelay) {
                        requestAnimationFrame(frame);
                        return;
                    }

                    lastTime = timestamp;
                    let completed = 0;

                    for (const line of lineStates) {
                        if (line.done) {
                            completed++;
                            continue;
                        }

                        line.progress += Math.max(1, Math.floor(Math.random() * 3));

                        if (line.progress >= line.finalText.length) {
                            line.progress = line.finalText.length;
                            line.done = true;
                            line.element.textContent = line.finalText;
                            completed++;
                            continue;
                        }

                        const revealed = line.finalText.slice(0, line.progress);

                        let scrambled = "";
                        const scrambleEnd = Math.min(line.progress + scrambleWindow, line.finalText.length);

                        for (let i = line.progress; i < scrambleEnd; i++) {
                            const c = line.finalText[i];

                            if (c === " ") {
                                scrambled += " ";
                            } else {
                                scrambled += chars[Math.floor(Math.random() * chars.length)];
                            }
                        }

                        line.element.textContent = revealed + scrambled;
                    }

                    fitPromptToViewport();

                    if (completed < lineStates.length) {
                        requestAnimationFrame(frame);
                    } else {
                        container.classList.add("finished");
                        fitPromptToViewport();

                        if (onComplete) {
                            onComplete();
                        }
                    }
                }

                requestAnimationFrame(frame);
            }

            function fitPromptToViewport() {
                const stage = document.getElementById("promptStage");
                const scaleBox = document.getElementById("promptScaleBox");

                if (!stage || !scaleBox) return;

                scaleBox.style.transform = "scale(1)";

                const stageRect = stage.getBoundingClientRect();
                const boxRect = scaleBox.getBoundingClientRect();

                if (boxRect.width === 0 || boxRect.height === 0) return;

                const padding = 12;
                const availableWidth = Math.max(0, stageRect.width - padding * 2);
                const availableHeight = Math.max(0, stageRect.height - padding * 2);

                const scaleX = availableWidth / boxRect.width;
                const scaleY = availableHeight / boxRect.height;
                const scale = Math.min(scaleX, scaleY, 1);

                scaleBox.style.transform = `scale(${scale})`;
            }
    </script>
</body>
</html>

